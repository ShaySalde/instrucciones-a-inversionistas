{
  "name": "utilidades-va6s",
  "productName": "Instrucciones a Inversionistas",
  "version": "1.0.0",
  "description": "Procesa payment tape / inversión y envía los reportes por correo a cada inversionista.",
  "author": "Salde",
  "license": "UNLICENSED",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "nodemailer": "^6.9.16"
  },
  "build": {
    "appId": "co.salde.utilidadesva6s",
    "productName": "Instrucciones a Inversionistas",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico",
      "artifactName": "Instrucciones-a-Inversionistas-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Instrucciones a Inversionistas"
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.business"
    }
  }
}
